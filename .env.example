# ElViolevador Bot - Environment Variables
# Copy this file to .env and fill in your values

# ─── Telegram Bot ──────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── User Access Control (optional) ────────────────────────────
# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
# Example: ALLOWED_USERS=123456789,987654321
ALLOWED_USERS=

# ─── Downloads ─────────────────────────────────────────────────
# Directory where temp files are stored before sending.
# Must be writable. Default: /downloads (works in Docker).
DOWNLOAD_DIR=/downloads

# Maximum file size in bytes (default 50 MB = Telegram bot limit).
MAX_FILE_BYTES=52428800

# ─── Rate Limiting ─────────────────────────────────────────────
# Max number of requests per user inside the time window.
RATE_LIMIT_CALLS=3
# Time window in seconds.
RATE_LIMIT_PERIOD=60

# ─── YouTube authentication (optional) ─────────────────────────
# Required to bypass YouTube's bot detection ("Sign in to confirm…").
# Option A — point to a cookies.txt file exported from your browser:
#   Install the "Get cookies.txt LOCALLY" Chrome/Firefox extension,
#   go to youtube.com while logged in, export cookies, save as cookies.txt.
# YOUTUBE_COOKIES_FILE=cookies.txt
#
# Option B — let yt-dlp extract cookies directly from your browser:
#   Values: chrome, firefox, edge, chromium, brave, opera, safari
# YOUTUBE_COOKIES_BROWSER=chrome

# ─── yt-dlp defaults (optional, used by MCP ytdlp_server) ──────
# YTDLP_DEFAULT_OUTPUT_DIR=C:/Users/Wilfreid/Downloads
